{
    "version": "1.0.0",
    "description": "Image viewer for Windows with HEIC/AVIF/RAW support",
    "homepage": "https://github.com/leoist/ImageViewer",
    "license": "MIT",
    "depends": "dotnet-desktop-runtime",
    "architecture": {
        "64bit": {
            "url": "https://github.com/leoist/ImageViewer/releases/download/v1.0.0/ImageViewer.zip",
            "hash": "eda12445d6d7f1667d92a793c53278172bb739ec9ab09b5043104eda0702af6b"
        }
    },
    "bin": "ImageViewer.exe",
    "shortcuts": [
        [
            "ImageViewer.exe",
            "ImageViewer"
        ]
    ],
    "post_install": [
        "reg add \"HKCU\\Software\\Classes\\ImageViewer.ImageViewer\" /ve /d \"ImageViewer\" /f",
        "reg add \"HKCU\\Software\\Classes\\ImageViewer.ImageViewer\\shell\\open\\command\" /ve /d \"\\\"$dir\\ImageViewer.exe\\\" \\\"%1\\\"\" /f",
        "reg add \"HKCU\\Software\\Classes\\ImageViewer.ImageViewer\\DefaultIcon\" /ve /d \"\\\"$dir\\ImageViewer.exe\\\",1\" /f",
        "foreach ($e in @('.jpg','.jpeg','.png','.bmp','.gif','.webp','.tiff','.tif','.ico','.heif','.heic','.avif','.cr2','.cr3','.nef','.arw','.dng','.orf','.rw2','.pef','.raf','.3fr','.kdc','.mrw','.nrw','.raw','.rwl','.srw','.x3f','.erf','.mef','.mos','.iiq')) { reg add \"HKCU\\Software\\Classes\\$e\" /ve /d \"ImageViewer.ImageViewer\" /f }",
        "assoc .dummy >nul 2>&1"
    ],
    "post_uninstall": [
        "foreach ($e in @('.jpg','.jpeg','.png','.bmp','.gif','.webp','.tiff','.tif','.ico','.heif','.heic','.avif','.cr2','.cr3','.nef','.arw','.dng','.orf','.rw2','.pef','.raf','.3fr','.kdc','.mrw','.nrw','.raw','.rwl','.srw','.x3f','.erf','.mef','.mos','.iiq')) { reg delete \"HKCU\\Software\\Classes\\$e\" /f >nul 2>&1 }",
        "reg delete \"HKCU\\Software\\Classes\\ImageViewer.ImageViewer\" /f >nul 2>&1",
        "assoc .dummy >nul 2>&1"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/leoist/ImageViewer/releases/download/v$version/ImageViewer.zip"
            }
        }
    }
}
