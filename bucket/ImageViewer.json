{
    "version": "1.0.0",
    "description": "Image viewer for Windows with HEIC/AVIF/RAW support",
    "homepage": "https://github.com/leoist/ImageViewer",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/leoist/ImageViewer/releases/download/v1.0.0/ImageViewer.zip",
            "hash": "eda12445d6d7f1667d92a793c53278172bb739ec9ab09b5043104eda0702af6b"
        }
    },
    "bin": "ImageViewer.exe",
    "shortcuts": [
        [
            "ImageViewer.exe",
            "ImageViewer"
        ]
    ],
    "post_install": [
        "$progId = 'ImageViewer.ImageViewer'",
        "$base = \"HKCU:\\Software\\Classes\\$progId\"",
        "New-Item -Path $base -Force | Out-Null",
        "Set-ItemProperty -Path $base -Name '(default)' -Value 'ImageViewer'",
        "Set-ItemProperty -Path $base -Name 'FriendlyTypeName' -Value 'ImageViewer'",
        "New-Item -Path \"$base\\shell\\open\\command\" -Force | Out-Null",
        "Set-ItemProperty -Path \"$base\\shell\\open\\command\" -Name '(default)' -Value ('\"' + $dir + '\\ImageViewer.exe\" \"%1\"')",
        "New-Item -Path \"$base\\DefaultIcon\" -Force | Out-Null",
        "Set-ItemProperty -Path \"$base\\DefaultIcon\" -Name '(default)' -Value ('\"' + $dir + '\\ImageViewer.exe\",1')",
        "$exts = @('.jpg','.jpeg','.png','.bmp','.gif','.webp','.tiff','.tif','.ico','.heif','.heic','.avif','.cr2','.cr3','.nef','.arw','.dng','.orf','.rw2','.pef','.raf','.3fr','.kdc','.mrw','.nrw','.raw','.rwl','.srw','.x3f','.erf','.mef','.mos','.iiq')",
        "foreach ($e in $exts) { New-Item -Path \"HKCU:\\Software\\Classes\\$e\" -Force | Out-Null; Set-ItemProperty -Path \"HKCU:\\Software\\Classes\\$e\" -Name '(default)' -Value $progId }"
    ],
    "post_uninstall": [
        "$exts = @('.jpg','.jpeg','.png','.bmp','.gif','.webp','.tiff','.tif','.ico','.heif','.heic','.avif','.cr2','.cr3','.nef','.arw','.dng','.orf','.rw2','.pef','.raf','.3fr','.kdc','.mrw','.nrw','.raw','.rwl','.srw','.x3f','.erf','.mef','.mos','.iiq')",
        "foreach ($e in $exts) { Remove-Item -Path \"HKCU:\\Software\\Classes\\$e\" -Recurse -ErrorAction SilentlyContinue }",
        "Remove-Item -Path 'HKCU:\\Software\\Classes\\ImageViewer.ImageViewer' -Recurse -ErrorAction SilentlyContinue"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/leoist/ImageViewer/releases/download/v$version/ImageViewer.zip"
            }
        }
    }
}
